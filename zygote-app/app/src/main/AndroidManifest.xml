<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Floating bubble overlay -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Local PWA server + WebView (127.0.0.1 only) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foreground service for the persistent bubble -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiChatSample"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">

        <!-- Floating bubble service -->
        <service
            android:name=".BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="on-device AI assistant floating bubble" />
        </service>

        <!-- Phone-control bridge: lets the on-device agent read the screen
             and dispatch gestures (tap / type / swipe) via accessibility. -->
        <service
            android:name=".PhoneControlService"
            android:exported="true"
            android:label="@string/phone_control_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Debug probe (ADB-only): runs phone tools in the app process. -->
        <receiver
            android:name=".A11yProbeReceiver"
            android:exported="true" />

        <!-- PWA surface: the app icon opens the DeepSeek-Harness-style UI -->
        <activity
            android:name=".PwaActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.AiChatSample">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
